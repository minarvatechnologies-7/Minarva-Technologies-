generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role { SUPER_ADMIN ADMIN SALES SERVICE_MANAGER TECHNICIAN ACCOUNTANT CONTENT_MARKETING CUSTOMER }
enum LeadStatus { NEW CONTACTED QUALIFIED SITE_SURVEY QUOTE_SENT NEGOTIATION WON LOST FOLLOW_UP }
enum LeadTemperature { HOT WARM COLD }
enum LeadSource { WEBSITE WHATSAPP PHONE GOOGLE GOOGLE_ADS FACEBOOK INSTAGRAM YOUTUBE REFERRAL DIRECT OTHER }
enum ServiceTicketStatus { NEW ASSIGNED TECHNICIAN_ON_THE_WAY INSPECTION ESTIMATE_PENDING CUSTOMER_APPROVAL_PENDING WORK_IN_PROGRESS PARTS_REQUIRED COMPLETED DELIVERED CANCELLED }

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  phone        String?
  role         Role     @default(CUSTOMER)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  customer        Customer?
  assignedLeads   Lead[]           @relation("LeadAssignee")
  assignedTickets ServiceTicket[]  @relation("TicketTechnician")
  leadActivities  LeadActivity[]
  auditLogs       AuditLog[]
  notifications   Notification[]
  sessions        Session[]
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  lastSeenAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, expiresAt])
}

model Customer {
  id          String   @id @default(cuid())
  userId      String?  @unique
  name        String
  phone       String
  whatsapp    String?
  email       String?
  address     String?
  city        String?
  district    String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user           User?          @relation(fields: [userId], references: [id])
  leads          Lead[]
  tickets        ServiceTicket[]
  warranties     Warranty[]
  quotations     Quotation[]
  invoices       Invoice[]
  reviews        Review[]
  referrals      Referral[]      @relation("Referrer")
  appointments   Appointment[]
  conversations  Conversation[]
}

model Lead {
  id            String          @id @default(cuid())
  leadNumber    Int             @unique @default(autoincrement())
  name          String
  phone         String
  whatsapp      String?
  email         String?
  location      String?
  serviceSlug   String
  requirement   String?
  budget        String?
  source        LeadSource      @default(WEBSITE)
  status        LeadStatus      @default(NEW)
  temperature   LeadTemperature @default(COLD)
  score         Int             @default(0)
  assignedToId  String?
  followUpAt   DateTime?
  notes         String?
  metadata      Json?
  customerId    String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  customer      Customer?       @relation(fields: [customerId], references: [id])
  assignedTo    User?           @relation("LeadAssignee", fields: [assignedToId], references: [id])
  activities    LeadActivity[]
  referral      Referral?
  appointments  Appointment[]
  quotations    Quotation[]
  @@index([status, temperature])
  @@index([source])
  @@index([followUpAt])
}

model LeadActivity {
  id String @id @default(cuid())
  leadId String
  userId String?
  type String
  body String
  createdAt DateTime @default(now())
  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id])
  @@index([leadId, createdAt])
}

model Appointment {
  id String @id @default(cuid())
  leadId String?
  customerId String?
  type String
  scheduledAt DateTime
  status String @default("SCHEDULED")
  notes String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  lead Lead? @relation(fields: [leadId], references: [id])
  customer Customer? @relation(fields: [customerId], references: [id])
  ticket ServiceTicket?
  @@index([scheduledAt, status])
}

model ServiceTicket {
  id String @id @default(cuid())
  ticketNumber Int @unique @default(autoincrement())
  customerId String
  technicianId String?
  appointmentId String? @unique
  serviceSlug String
  propertyType String?
  location String?
  problem String?
  status ServiceTicketStatus @default(NEW)
  priority String @default("NORMAL")
  estimateAmount Decimal? @db.Decimal(12, 2)
  approvedAt DateTime?
  completedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  customer Customer @relation(fields: [customerId], references: [id])
  technician User? @relation("TicketTechnician", fields: [technicianId], references: [id])
  appointment Appointment? @relation(fields: [appointmentId], references: [id])
  timeline ServiceTimeline[]
  parts TicketPart[]
  warrantyClaims WarrantyClaim[]
  @@index([status, priority])
  @@index([customerId, createdAt])
}

model ServiceTimeline {
  id String @id @default(cuid())
  ticketId String
  status String
  note String?
  photoUrls String[]
  signatureUrl String?
  createdAt DateTime @default(now())
  ticket ServiceTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  @@index([ticketId, createdAt])
}

model ProductCategory {
  id String @id @default(cuid())
  name String @unique
  slug String @unique
  createdAt DateTime @default(now())
  products Product[]
}

model Product {
  id String @id @default(cuid())
  categoryId String
  name String
  slug String @unique
  description String?
  specifications Json?
  imageUrls String[]
  sku String? @unique
  isUsed Boolean @default(false)
  active Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  category ProductCategory @relation(fields: [categoryId], references: [id])
  quoteItems QuotationItem[]
  warranties Warranty[]
  @@index([categoryId, active])
}

model Warranty {
  id String @id @default(cuid())
  customerId String
  productId String?
  serialNumber String
  invoiceRef String?
  purchaseDate DateTime?
  startsAt DateTime
  expiresAt DateTime
  status String @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  customer Customer @relation(fields: [customerId], references: [id])
  product Product? @relation(fields: [productId], references: [id])
  claims WarrantyClaim[]
  @@index([serialNumber])
  @@index([expiresAt, status])
}

model WarrantyClaim {
  id String @id @default(cuid())
  warrantyId String
  ticketId String?
  openedAt DateTime @default(now())
  closedAt DateTime?
  status String @default("OPEN")
  notes String?
  warranty Warranty @relation(fields: [warrantyId], references: [id], onDelete: Cascade)
  ticket ServiceTicket? @relation(fields: [ticketId], references: [id])
}

model Quotation {
  id String @id @default(cuid())
  quoteNumber Int @unique @default(autoincrement())
  customerId String
  leadId String?
  status String @default("DRAFT")
  validUntil DateTime?
  subtotal Decimal @default(0) @db.Decimal(12, 2)
  tax Decimal @default(0) @db.Decimal(12, 2)
  total Decimal @default(0) @db.Decimal(12, 2)
  notes String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  customer Customer @relation(fields: [customerId], references: [id])
  lead Lead? @relation(fields: [leadId], references: [id])
  items QuotationItem[]
}

model QuotationItem {
  id String @id @default(cuid())
  quotationId String
  productId String?
  description String
  quantity Decimal @default(1) @db.Decimal(10, 2)
  unitPrice Decimal @default(0) @db.Decimal(12, 2)
  amount Decimal @default(0) @db.Decimal(12, 2)
  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id])
}

model Invoice {
  id String @id @default(cuid())
  invoiceNumber String @unique
  customerId String
  status String @default("UNPAID")
  total Decimal @db.Decimal(12, 2)
  balance Decimal @db.Decimal(12, 2)
  issuedAt DateTime @default(now())
  dueAt DateTime?
  customer Customer @relation(fields: [customerId], references: [id])
  payments Payment[]
}

model Payment {
  id String @id @default(cuid())
  invoiceId String
  amount Decimal @db.Decimal(12, 2)
  provider String?
  reference String?
  status String @default("PENDING")
  paidAt DateTime?
  createdAt DateTime @default(now())
  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

model Project {
  id String @id @default(cuid())
  title String
  slug String @unique
  customerType String?
  location String?
  problem String?
  solution String?
  photoUrls String[]
  services String[]
  result String?
  published Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Review {
  id String @id @default(cuid())
  customerId String
  rating Int
  feedback String
  source String @default("WEBSITE")
  status String @default("PENDING")
  createdAt DateTime @default(now())
  customer Customer @relation(fields: [customerId], references: [id])
}

model Referral {
  id String @id @default(cuid())
  referrerId String
  leadId String @unique
  status String @default("PENDING")
  reward String?
  createdAt DateTime @default(now())
  referrer Customer @relation("Referrer", fields: [referrerId], references: [id])
  lead Lead @relation(fields: [leadId], references: [id])
}

model Campaign {
  id String @id @default(cuid())
  name String
  channel String
  sourceKey String? @unique
  active Boolean @default(true)
  createdAt DateTime @default(now())
  events CampaignEvent[]
}

model CampaignEvent {
  id String @id @default(cuid())
  campaignId String
  eventType String
  leadId String?
  metadata Json?
  createdAt DateTime @default(now())
  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  @@index([campaignId, eventType, createdAt])
}

model Conversation {
  id String @id @default(cuid())
  customerId String?
  channel String @default("WEB")
  startedAt DateTime @default(now())
  endedAt DateTime?
  summary String?
  customer Customer? @relation(fields: [customerId], references: [id])
  messages ConversationMessage[]
}

model ConversationMessage {
  id String @id @default(cuid())
  conversationId String
  role String
  content String
  metadata Json?
  createdAt DateTime @default(now())
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  @@index([conversationId, createdAt])
}

model Notification {
  id String @id @default(cuid())
  userId String
  channel String
  type String
  status String @default("PENDING")
  payload Json
  sentAt DateTime?
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model BlogPost {
  id String @id @default(cuid())
  title String
  slug String @unique
  excerpt String?
  content String
  author String?
  category String?
  coverImage String?
  publishedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FAQ {
  id String @id @default(cuid())
  question String
  answer String
  category String?
  published Boolean @default(true)
  createdAt DateTime @default(now())
}

model AuditLog {
  id String @id @default(cuid())
  userId String?
  action String
  entity String
  entityId String?
  metadata Json?
  createdAt DateTime @default(now())
  user User? @relation(fields: [userId], references: [id])
  @@index([entity, entityId, createdAt])
}

model TicketPart {
  id String @id @default(cuid())
  ticketId String
  name String
  quantity Decimal @default(1) @db.Decimal(10, 2)
  unitCost Decimal @default(0) @db.Decimal(12, 2)
  ticket ServiceTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
}
